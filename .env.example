# =============================================================================
# Tender Tracker Environment Configuration
# =============================================================================

# --- Environment Mode ---
# Set to 'production' on Render Web Service
NODE_ENV=production

# --- Port Configuration ---
# Port is automatically assigned by Render in production (leave unset on Render).
# Defaults to 8787 for local development.
PORT=8787

# --- PostgreSQL / Supabase Connection ---
# Production should use the Supabase Transaction Pooler (port 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require"

# Optional pool configuration:
# PG_POOL_MAX=10

# Alternatively, discrete PostgreSQL parameters:
# PGHOST=aws-0-[region].pooler.supabase.com
# PGPORT=6543
# PGDATABASE=postgres
# PGUSER=postgres.[project-ref]
# PGPASSWORD=your_database_password
# PGSSLMODE=require

# --- Supabase API & Storage Configuration ---
# Required for Supabase Storage and PostgreSQL backups
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
# SUPABASE_ANON_KEY="your_supabase_anon_key"

# --- Cloud Backup & Scheduled Triggers ---
# Shared secret for authenticating POST /api/backup/now (Bearer token or x-cron-secret header)
CRON_SECRET="your_strong_random_cron_secret"
# TENDER_BACKUP_RETENTION=7

# --- SQLite Local Development Only ---
# In production, SQLite fallback is strictly blocked.
# TENDER_DB_PATH="data/tender-tracker.sqlite"
# TENDER_DB_SEED=0
# DO NOT set USE_SQLITE or TENDER_DRIVER in production!
